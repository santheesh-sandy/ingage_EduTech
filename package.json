{
  "name": "ingage-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "ingage EduTech website with a chatbot that uses predefined Q&A first and a live AI API for everything else",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/dev-server.mjs",
    "dev": "node server/dev-server.mjs --mock",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "deploy:fn": "node scripts/deploy-fn.mjs",
    "check-ai": "node scripts/check-ai.mjs",
    "db:push": "node scripts/sb-sql.mjs supabase/migrations/20261120090000_learner_data.sql && node scripts/sb-sql.mjs supabase/migrations/20261120120000_resumes.sql",
    "gold": "node scripts/gold-eval.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2"
  }
}
